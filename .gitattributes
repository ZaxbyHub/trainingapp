# CSP pin stability (issue #60): desktop/main/security/csp.ts hash-pins the inline
# theme-bootstrap script of this file, so its served bytes must be identical on
# every checkout regardless of core.autocrlf. LF everywhere, no exceptions.
web_ui/index.html text eol=lf

# Byte-stable paths (issue #77): the Storyline fixture payloads and the packtool
# acceptance checks are hashed byte-for-byte by the issue-tracer checkpoint
# manifest; CRLF conversion on checkout would break blob verification and
# golden-file equality. No conversion, no exceptions.
tests/fixtures/storyline-mini/** -text
packtool/** -text
desktop/e2e/fixtures/storyline-nav/** -text
contracts/fixtures/packs/** -text

# Issue #73: the build-docs fixture sources hash into docs[].sha256 at build
# time; byte-stable checkouts keep two builds reproducible cross-machine.
contracts/fixtures/source-docs/** -text

# E1 staging scripts (issue #84): both carry a #!/usr/bin/env node shebang AND
# are dynamically imported by desktop vitest specs (the consumer-contract
# spec). Vite's SSR module runner throws SyntaxError on shebang + CRLF even
# though plain node accepts it, and a fresh Windows CI checkout materializes
# CRLF without an eol rule. LF everywhere, no exceptions.
desktop/scripts/*.mjs text eol=lf

# Harness runners (issue #216 AC5; PR #220 review PRR-017 + final-critic):
# the bench and web_ui script runners carry #!/usr/bin/env node shebangs and
# are now dynamically imported by desktop vitest specs
# (harness-runner-contract-*.test.ts) — the same shebang + CRLF SyntaxError
# surface as the E1 staging scripts above. The shared kill wrapper
# (scripts/kill-guard.mjs) is imported by the specs and e2e helpers too, and
# its .d.mts declaration is covered for checkout byte-stability. Globs below
# cover the top-level and nested script trees these specs import; LF
# everywhere in them.
bench/*.mjs text eol=lf
web_ui/scripts/*.mjs text eol=lf
web_ui/scripts/**/*.mjs text eol=lf
scripts/*.mjs text eol=lf
scripts/*.mts text eol=lf

# Twinned pack archive rules (trace browser-training-parity, ADR-0012): the
# desktop and browser copies are compared byte-for-byte by
# desktop/src/__tests__/pack-archive-rules-drift.test.ts, so both must check
# out with the same line endings on every machine. LF everywhere.
desktop/main/backend/packs/pack-archive-rules.ts text eol=lf
web_ui/src/lib/packs/pack-archive-rules.ts text eol=lf

# Vendored SheetJS tarball (issue #276 AC1): the three lockfiles pin its
# sha512 as the xlsx integrity, so the bytes must never be eol-converted.
vendor/sheetjs/*.tgz binary

# Issue #319: the xlsx parity golden is the EXACT extractor output (LF line
# breaks, no trailing newline); any EOL conversion breaks the byte-equality
# pin on Windows checkouts (core.autocrlf=true on hosted runners).
contracts/fixtures/xlsx-parity/parity.expected.txt -text
tests/test_319_guards.py -text
tests/test_master_push_advisory_scan.py -text
# Issue #320 parity goldens: sha256-pinned JSON captured WITHOUT a trailing
# newline (the recorded capture scripts' exact bytes). -text keeps git's EOL
# machinery away; the byte-exactness hooks (trailing-whitespace,
# end-of-file-fixer) are excluded for these dirs in .pre-commit-config.yaml -
# the full xlsx-parity pattern (attribute + hook excludes) - so every
# platform's checkout and every pre-commit run reproduces the pinned hashes.
contracts/fixtures/pdf-parity/** -text
contracts/fixtures/pack-extract-parity/** -text
