{
  "_comment": "Shared scrubSecrets(text, apiKey) vectors (PR #142 F-018). Consumed by BOTH twins: desktop/src/__tests__/scrub-secrets-vectors.test.ts (desktop/main/backend/net/provider-error.ts) and web_ui/src/lib/llm/scrub-secrets-vectors.test.ts (web_ui/src/lib/llm/provider-error.ts). `expected` was generated by the desktop implementation; the two must agree on every row. Test keys are deliberately not sk- shaped except in the sk- rows, so the generic sk- mask cannot hide a missed redaction.",
  "cases": [
    {
      "name": "verbatim key",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "Incorrect API key provided: Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe. Check your key.",
      "expected": "Incorrect API key provided: [redacted]. Check your key."
    },
    {
      "name": "encodeURIComponent upper-case hex",
      "key": "Zq9_Live<&>\"'Key/+=Mid",
      "input": "GET /v1/models?key=Zq9_Live%3C%26%3E%22'Key%2F%2B%3DMid failed",
      "expected": "GET /v1/models?key=[redacted] failed"
    },
    {
      "name": "encodeURIComponent lower-case hex",
      "key": "Zq9_Live<&>\"'Key/+=Mid",
      "input": "GET /v1/models?key=Zq9_Live%3c%26%3e%22'key%2f%2b%3dmid failed",
      "expected": "GET /v1/models?key=[redacted] failed"
    },
    {
      "name": "named entities incl. &apos; and &amp;",
      "key": "Zq9_Live<&>\"'Key/+=Mid",
      "input": "echo: Zq9_Live&lt;&amp;&gt;&quot;&apos;Key/+=Mid done",
      "expected": "echo: [redacted] done"
    },
    {
      "name": "numeric entity &#x27; for the apostrophe",
      "key": "Zq9_Live<&>\"'Key/+=Mid",
      "input": "echo: Zq9_Live&lt;&amp;&gt;&quot;&#x27;Key/+=Mid done",
      "expected": "echo: [redacted] done"
    },
    {
      "name": "all-decimal numeric entities",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "echo: &#72;&#119;&#51;&#82;&#116;&#55;&#76;&#109;&#80;&#122;&#57;&#81;&#100;&#86;&#120;&#50;&#66;&#110;&#75;&#99;&#53;&#89;&#115;&#71;&#102;&#56;&#74;&#97;&#85;&#101; end",
      "expected": "echo: [redacted] end"
    },
    {
      "name": "all-hex numeric entities (upper X, mixed case digits)",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "echo: &#X48;&#X77;&#X33;&#X52;&#X74;&#X37;&#X4C;&#X6D;&#X50;&#X7A;&#X39;&#X51;&#X64;&#X56;&#X78;&#X32;&#X42;&#X6E;&#X4B;&#X63;&#X35;&#X59;&#X73;&#X47;&#X66;&#X38;&#X4A;&#X61;&#X55;&#X65; end",
      "expected": "echo: [redacted] end"
    },
    {
      "name": "lower-case hex numeric entities",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "echo: &#x48;&#x77;&#x33;&#x52;&#x74;&#x37;&#x4c;&#x6d;&#x50;&#x7a;&#x39;&#x51;&#x64;&#x56;&#x78;&#x32;&#x42;&#x6e;&#x4b;&#x63;&#x35;&#x59;&#x73;&#x47;&#x66;&#x38;&#x4a;&#x61;&#x55;&#x65; end",
      "expected": "echo: [redacted] end"
    },
    {
      "name": "case variant: upper-cased key",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "got HW3RT7LMPZ9QDVX2BNKC5YSGF8JAUE from upstream",
      "expected": "got [redacted] from upstream"
    },
    {
      "name": "case variant: lower-cased key",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "got hw3rt7lmpz9qdvx2bnkc5ysgf8jaue from upstream",
      "expected": "got [redacted] from upstream"
    },
    {
      "name": "12-char mid-key echo is redacted",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "fragment Pz9QdVx2BnKc seen",
      "expected": "fragment [redacted] seen"
    },
    {
      "name": "11-char mid-key echo is NOT redacted (boundary)",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "fragment z9QdVx2BnKc seen",
      "expected": "fragment z9QdVx2BnKc seen"
    },
    {
      "name": "first 8 characters only",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "prefix Hw3Rt7Lm seen",
      "expected": "prefix [redacted] seen"
    },
    {
      "name": "last 8 characters only",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "suffix sGf8JaUe seen",
      "expected": "suffix [redacted] seen"
    },
    {
      "name": "mixed forms in one text",
      "key": "Zq9_Live<&>\"'Key/+=Mid",
      "input": "a Zq9_Live<&>\"'Key/+=Mid b Zq9_Live%3C%26%3E%22'Key%2F%2B%3DMid c Zq9_Live&lt;&amp;&gt;&quot;&#39;Key/+=Mid d ZQ9_LIVE<&>\"'KEY/+=MID",
      "expected": "a [redacted] b [redacted] c [redacted] d [redacted]"
    },
    {
      "name": "key containing a literal %41 (not decoded away)",
      "key": "Ab%41Cd-literal-Pct-Key9",
      "input": "echo Ab%41Cd-literal-Pct-Key9 and Ab%2541Cd-literal-Pct-Key9",
      "expected": "echo [redacted] and [redacted]"
    },
    {
      "name": "key containing a literal &amp; (not decoded away)",
      "key": "Ab&amp;Cd-literal-Amp-Key9",
      "input": "echo Ab&amp;Cd-literal-Amp-Key9 and Ab&amp;amp;Cd-literal-Amp-Key9",
      "expected": "echo [redacted] and [redacted]"
    },
    {
      "name": "no key present in the text",
      "key": "Hw3Rt7LmPz9QdVx2BnKc5YsGf8JaUe",
      "input": "The server returned 502 Bad Gateway for model llama3.",
      "expected": "The server returned 502 Bad Gateway for model llama3."
    },
    {
      "name": "empty key leaves text alone",
      "key": "",
      "input": "nothing to redact here",
      "expected": "nothing to redact here"
    },
    {
      "name": "sk- mask applied to a key-shaped token",
      "key": "unrelated-key-value-123456",
      "input": "upstream said sk-proj-abcDEF123_xyz-789 is invalid",
      "expected": "upstream said sk-[redacted] is invalid"
    },
    {
      "name": "sk- key is redacted by key scrub then mask",
      "key": "sk-LiveKey0123456789abcdef",
      "input": "bad key sk-LiveKey0123456789abcdef; also sk-other9999 seen",
      "expected": "bad key [redacted]; also sk-[redacted] seen"
    }
  ]
}
